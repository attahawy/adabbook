{
  "name": "adabbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "import:pages": "node scripts/import-pages.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "verify:data": "node scripts/verify-data.mjs",
    "notifications:preview": "node scripts/notify-new-pages.mjs --dry-run",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run verify:data && vite build && node scripts/generate-pages.mjs && node scripts/verify-site.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "cheerio": "^1.2.0",
    "firebase-admin": "^14.5.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "vite": "^8.3.4"
  }
}
