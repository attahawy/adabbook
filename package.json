{
  "name": "adabbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "import:pages": "node scripts/import-pages.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "verify:data": "node scripts/verify-data.mjs",
    "test": "node --test tests/*.test.mjs",
    "index:search": "node scripts/build-search-index.mjs",
    "build": "npm run index:search && npm run verify:data && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "cheerio": "^1.2.0",
    "vite": "^8.3.4"
  }
}
